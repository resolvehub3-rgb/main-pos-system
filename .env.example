# Supabase Configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Server & Application Configuration
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Optional Payment Gateway API Keys (Paystack / Mobile Money)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# NO super-admin credentials belong here. VITE_ variables are compiled into the
# public web bundle, so any secret placed in one is shipped to every visitor.
# The first super admin is provisioned once via the
# Supabase Admin API using the service-role key — kept server-side only, never
# in a VITE_ variable and never in client build config.

# Local print bridge (optional).
# The bridge is a tiny helper service that runs on the POS machine and writes
# ESC/POS bytes straight to a USB/thermal printer, so the cashier's "confirm &
# print" goes to hardware instead of the browser print dialog. Start it with
# `npm run print-bridge`. If it isn't running, the app automatically falls back
# to the browser print dialog — so leaving this unset is always safe.
VITE_PRINT_BRIDGE_URL="http://127.0.0.1:9210"

# Print bridge service settings (read by `npm run print-bridge`, NOT the browser).
# PRINT_BRIDGE_PORT=9210
# PRINT_BRIDGE_HOST=127.0.0.1
# Origins allowed to call the bridge (comma separated, exact match).
# Unset (recommended): any origin served from this machine, on any port — so it
# keeps working when vite moves from 3000 to 3001. Set it to pin specific
# origins, which you must do if the till browser runs on another machine.
# PRINT_BRIDGE_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# Shared secret the POS app must present. Generated automatically on first run and
# stored in print-bridge/.bridge-token if left unset.
# PRINT_BRIDGE_TOKEN=""
# How to reach the printer: auto (default), usb, network, or file.
# PRINT_TRANSPORT="auto"
# Windows printer name. Auto-detected (USB first, then OS default) if unset.
# PRINT_PRINTER=""
# For a network/Ethernet printer instead of USB.
# PRINT_NETWORK_HOST=""
# PRINT_NETWORK_PORT=9100
# Where receipts are spooled when no printer is configured (also used for dev).
# PRINT_SPOOL_DIR="./print-spool"

