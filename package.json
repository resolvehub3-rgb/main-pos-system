{
  "name": "samtill-pos",
  "private": true,
  "version": "1.0.0",
  "description": "Multi-tenant supermarket and retail POS for Ghanaian businesses — barcode checkout, inventory ledger, live sales analytics and role-based access.",
  "author": "SamTill",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts",
    "print-bridge": "tsx print-bridge/server.ts",
    "desktop:assets": "tsx scripts/make-ico.ts",
    "desktop:build": "node scripts/build-electron.mjs",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "desktop:dist": "pnpm run build && pnpm run desktop:assets && pnpm run desktop:build && electron-builder --win nsis --config electron-builder.config.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
